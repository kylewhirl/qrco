{
  "name": "qr-co",
  "version": "0.1.0",
  "private": true,
  "description": "The tqrco web app, API, docs site, and TypeScript SDK.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3002 --turbopack",
    "dev:site": "npm run dev",
    "dev:docs": "npm --prefix apps/docs run dev -- --port 3003",
    "dev:all": "sh -c 'trap \"kill 0\" INT TERM EXIT; npm run dev:site & npm run dev:docs & wait'",
    "seed:billing-users": "node --env-file=.env.local scripts/seed-billing-users.cjs",
    "verify:billing-users": "node --env-file=.env.local scripts/verify-billing-users.cjs",
    "build:sdk": "npm --prefix packages/tqrco run build",
    "check": "npm run lint -- --max-warnings=0 && npx tsc --noEmit --incremental false && npm run build:sdk",
    "check:docs": "npm --prefix apps/docs run build",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate-database.mjs",
    "prebuild": "npm run db:migrate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3",
    "uuid@<11.1.1": "11.1.1"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^6.8.1",
    "@stripe/stripe-js": "^9.13.0",
    "@aws-sdk/client-s3": "^3.1110.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@flatten-js/core": "^1.6.13",
    "@neondatabase/serverless": "^1.0.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-accordion": "^1.2.10",
    "@radix-ui/react-avatar": "^1.1.9",
    "@radix-ui/react-checkbox": "^1.3.1",
    "@radix-ui/react-collapsible": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.13",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-label": "^2.1.6",
    "@radix-ui/react-popover": "^1.1.13",
    "@radix-ui/react-scroll-area": "^1.2.8",
    "@radix-ui/react-select": "^2.2.4",
    "@radix-ui/react-separator": "^1.1.6",
    "@radix-ui/react-slider": "^1.3.4",
    "@radix-ui/react-slot": "^1.2.2",
    "@radix-ui/react-switch": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.11",
    "@radix-ui/react-toggle": "^1.1.8",
    "@radix-ui/react-toggle-group": "^1.1.9",
    "@radix-ui/react-tooltip": "^1.2.6",
    "@stackframe/stack": "^2.8.12",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-table": "^9.1.2",
    "@tanstack/react-virtual": "^3.14.9",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "canvas": "^3.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fuse.js": "^7.1.0",
    "jsdom": "^30.0.1",
    "lottie-react": "^2.4.1",
    "lucide": "^1.31.0",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "next": "16.3.1",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "paper": "^0.12.18",
    "path-that-svg": "^1.2.4",
    "phone": "^3.1.72",
    "prisma": "^7.9.1",
    "qr-code-styling": "^1.9.2",
    "react": "^19.2.8",
    "react-best-gradient-color-picker": "^3.0.14",
    "react-color": "^2.19.3",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.2.8",
    "react-icons": "^5.5.0",
    "react-phone-number-input": "^3.4.12",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "stripe": "^22.5.0",
    "svg-flatten": "^1.0.1",
    "svgson": "^5.3.1",
    "tailwind-merge": "^3.2.0",
    "tqrco": "file:packages/tqrco",
    "use-debounce": "^10.0.4",
    "usehooks-ts": "^3.1.1",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/xmldom": "^0.1.34",
    "eslint": "^10",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.2.9",
    "typescript": "^7"
  }
}
